---
import { getContentUrl, getContentTypeLabel } from '../lib/content';
import type { UnifiedContentItem } from '../lib/content';

interface Props extends UnifiedContentItem {}

const { item, type } = Astro.props;
const url = getContentUrl(item);
const typeLabel = getContentTypeLabel(type);

// Get first line or excerpt for snippets
const getSnippetPreview = async () => {
  if (type === 'snippets') {
    const { compiledContent } = await item.render();
    const text = compiledContent();
    // Extract plain text and get first 100 chars
    const plainText = text.replace(/<[^>]*>/g, '');
    return plainText.slice(0, 100) + (plainText.length > 100 ? '...' : '');
  }
  return null;
};

const snippetPreview = await getSnippetPreview();
---

<article class="timeline-item" data-type={type}>
  <span class="content-type">{typeLabel}</span>

  {type === 'posts' && (
    <>
      <h3><a href={url}>{item.data.title}</a></h3>
      {item.data.description && <p class="description">{item.data.description}</p>}
    </>
  )}

  {type === 'snippets' && (
    <a href={url} class="snippet-preview">
      {snippetPreview}
    </a>
  )}

  {type === 'quotations' && (
    <blockquote>
      <a href={url}>
        {item.data.quote.slice(0, 150)}{item.data.quote.length > 150 ? '...' : ''}
      </a>
      <footer>— {item.data.author}</footer>
    </blockquote>
  )}

  {type === 'til' && (
    <>
      <h3><a href={url}>{item.data.title}</a></h3>
      {item.data.category && <span class="category">{item.data.category}</span>}
    </>
  )}

  {type === 'webmarks' && (
    <>
      <h3><a href={url}>{item.data.title}</a></h3>
      {item.data.description && <p class="description">{item.data.description}</p>}
      <a href={item.data.url} class="external-link" target="_blank" rel="noopener noreferrer">
        {item.data.url}
      </a>
    </>
  )}

  <footer class="meta">
    {item.data.tags.length > 0 && (
      <div class="tags">
        {item.data.tags.map((tag: string) => (
          <a href={`/tags/${tag}/`}>#{tag}</a>
        ))}
      </div>
    )}
  </footer>
</article>

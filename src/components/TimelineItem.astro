---
interface Props {
  type: 'post' | 'snippet' | 'quotation' | 'til' | 'webmark';
  title?: string;
  description?: string;
  url: string;
  tags?: string[];
  time?: string;
}

const { type, title, description, url, tags = [], time } = Astro.props;

const typeLabels = {
  post: 'POST',
  snippet: 'SNIPPET',
  quotation: 'QUOTE',
  til: 'TIL',
  webmark: 'WEBMARK',
};

const typeLabel = typeLabels[type];
---

<article class="timeline-item border-l-2 border-border pl-4 py-2 hover:border-accent transition-colors">
  <div class="text-xs opacity-50 mb-1 uppercase font-bold tracking-wider flex items-center gap-2">
    <span>{typeLabel}</span>
    {time && <span class="normal-case font-normal">@ {time}</span>}
  </div>

  {type === 'webmark' && title && description && (
    <p class="opacity-90 text-sm mb-2">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="font-bold text-accent decoration-dashed hover:underline no-underline"
      >
        {title} ↗
      </a>{' '}
      {description}
    </p>
  )}

  {type !== 'webmark' && title && (
    <h3 class="text-lg font-medium mb-1 not-italic">
      <a
        href={url}
        class="text-accent decoration-dashed underline-offset-4 no-underline hover:underline"
      >
        {title}
      </a>
    </h3>
  )}

  {description && !title && (
    <p class="opacity-90 text-sm mb-2">
      <a
        href={url}
        class="text-foreground decoration-dashed hover:text-accent"
      >
        {description}
      </a>
    </p>
  )}

  {type !== 'webmark' && description && title && (
    <p class="opacity-90 text-sm mb-2">{description}</p>
  )}

  <slot />

  {tags.length > 0 && (
    <div class="flex gap-2 flex-wrap mt-2">
      {tags.map((tag) => (
        <a
          href={`/tags/${tag}`}
          class="text-xs no-underline text-foreground border-b-2 border-dashed border-foreground hover:text-accent hover:border-accent transition-colors"
        >
          #{tag}
        </a>
      ))}
    </div>
  )}
</article>

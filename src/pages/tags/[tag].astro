---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TimelineGroup from '../../components/TimelineGroup.astro';
import TimelineItem from '../../components/TimelineItem.astro';
import { getPostDateAndSlug, getPostUrl } from '../../lib/posts';

interface Props {
  tag: string;
  posts: CollectionEntry<'posts'>[];
}

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => {
    return data.draft !== true;
  });

  // Group posts by tag
  const tagGroups = new Map<string, CollectionEntry<'posts'>[]>();

  posts.forEach((post) => {
    post.data.tags.forEach((tag) => {
      if (!tagGroups.has(tag)) {
        tagGroups.set(tag, []);
      }
      tagGroups.get(tag)!.push(post);
    });
  });

  return Array.from(tagGroups.entries()).map(([tag, tagPosts]) => {
    return {
      params: { tag },
      props: { tag, posts: tagPosts },
    };
  });
}

const { tag, posts } = Astro.props;

// Group posts by date for display
const groupedPosts = posts
  .sort((a, b) => {
    const aDate = getPostDateAndSlug(a).date;
    const bDate = getPostDateAndSlug(b).date;
    return bDate.getTime() - aDate.getTime();
  })
  .reduce((groups, post) => {
    const { date } = getPostDateAndSlug(post);
    const dateStr = date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });

    if (!groups[dateStr]) {
      groups[dateStr] = [];
    }
    groups[dateStr].push(post);
    return groups;
  }, {} as Record<string, typeof posts>);
---

<BaseLayout title={`Posts tagged #${tag}`} description={`All posts tagged with ${tag}`}>
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-2 text-[var(--color-terminal-accent)]">
      #{tag}
    </h1>
    <p class="opacity-75">
      {posts.length} {posts.length === 1 ? 'post' : 'posts'}
    </p>
  </div>

  <div class="space-y-8">
    {Object.entries(groupedPosts).map(([date, datePosts]) => (
      <TimelineGroup date={date}>
        {datePosts.map((post) => (
          <TimelineItem
            type="post"
            title={post.data.title}
            description={post.data.description}
            url={getPostUrl(post)}
            tags={post.data.tags}
          />
        ))}
      </TimelineGroup>
    ))}
  </div>
</BaseLayout>

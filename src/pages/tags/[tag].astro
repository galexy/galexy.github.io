---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TimelineItem from '../../components/TimelineItem.astro';
import { getAllContent, filterByTag } from '../../lib/content';

export async function getStaticPaths() {
  const allContent = await getAllContent();
  const uniqueTags = [...new Set(allContent.map(({ item }) => item.data.tags).flat())];

  return uniqueTags.map(tag => {
    const filteredContent = filterByTag(allContent, tag);
    return {
      params: { tag },
      props: { content: filteredContent }
    };
  });
}

const { tag } = Astro.params;
const { content } = Astro.props;
---

<BaseLayout title={`Tag: ${tag}`} description={`All content tagged with "${tag}"`}>
  <div class="posts">
    <h1 class="posts-title">
      <span style="color: var(--foreground)">Content for: <span style="color: var(--accent)">#{tag}</span></span>
    </h1>
    {content.length === 0 ? (
      <p>No content found with this tag.</p>
    ) : (
      <div class="timeline-items">
        {content.map((contentItem) => (
          <TimelineItem {...contentItem} />
        ))}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  .posts-title {
    color: var(--foreground);
    margin-top: 0 !important;
    margin-bottom: 30px !important;
    padding-bottom: 0 !important;
    border-bottom: none !important;
  }
  
  .posts-title::after {
    display: none !important;
  }
</style>
---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TimelineGroup from '../../components/TimelineGroup.astro';
import TimelineItem from '../../components/TimelineItem.astro';
import { getPostDateAndSlug, getPostUrl } from '../../lib/posts';
import { getQuotationDateAndSlug, getQuotationUrl, getQuotationPreview } from '../../lib/quotations';
import { getTilDateAndSlug, getTilUrl, getTilPreview } from '../../lib/til';
import { getWebmarkDateAndSlug, getWebmarkUrl, getWebmarkPreview } from '../../lib/webmarks';

type TimelineItemData = {
  type: 'post' | 'snippet' | 'quotation' | 'til' | 'webmark';
  date: Date;
  url: string;
  title?: string;
  description?: string;
  tags: string[];
};

interface Props {
  tag: string;
  items: TimelineItemData[];
}

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true);
  const snippets = await getCollection('snippets', ({ data }) => data.draft !== true);
  const quotations = await getCollection('quotations', ({ data }) => data.draft !== true);
  const tils = await getCollection('til', ({ data }) => data.draft !== true);
  const webmarks = await getCollection('webmarks', ({ data }) => data.draft !== true);

  // Collect all unique tags
  const tagGroups = new Map<string, TimelineItemData[]>();

  // Add posts to tag groups
  posts.forEach((post) => {
    const { date } = getPostDateAndSlug(post);
    post.data.tags.forEach((tag) => {
      if (!tagGroups.has(tag)) {
        tagGroups.set(tag, []);
      }
      tagGroups.get(tag)!.push({
        type: 'post',
        date,
        url: getPostUrl(post),
        title: post.data.title,
        description: post.data.description,
        tags: post.data.tags,
      });
    });
  });

  // Add snippets to tag groups
  snippets.forEach((snippet) => {
    const preview = snippet.body.replace(/```[\s\S]*?```/g, '[code]').replace(/[#*`]/g, '').replace(/\s+/g, ' ').trim();
    const truncated = preview.length > 150 ? preview.substring(0, 150) + '...' : preview;

    snippet.data.tags.forEach((tag) => {
      if (!tagGroups.has(tag)) {
        tagGroups.set(tag, []);
      }
      tagGroups.get(tag)!.push({
        type: 'snippet',
        date: new Date(snippet.data.createdAt),
        url: `/snippets/${snippet.slug}`,
        description: truncated,
        tags: snippet.data.tags,
      });
    });
  });

  // Add quotations to tag groups
  quotations.forEach((quotation) => {
    const { date } = getQuotationDateAndSlug(quotation);
    quotation.data.tags.forEach((tag) => {
      if (!tagGroups.has(tag)) {
        tagGroups.set(tag, []);
      }
      tagGroups.get(tag)!.push({
        type: 'quotation',
        date,
        url: getQuotationUrl(quotation),
        description: `"${getQuotationPreview(quotation)}" — ${quotation.data.author}`,
        tags: quotation.data.tags,
      });
    });
  });

  // Add TILs to tag groups
  tils.forEach((til) => {
    const { date } = getTilDateAndSlug(til);
    til.data.tags.forEach((tag) => {
      if (!tagGroups.has(tag)) {
        tagGroups.set(tag, []);
      }
      tagGroups.get(tag)!.push({
        type: 'til',
        date,
        url: getTilUrl(til),
        description: getTilPreview(til),
        tags: til.data.tags,
      });
    });
  });

  // Add webmarks to tag groups
  webmarks.forEach((webmark) => {
    const { date } = getWebmarkDateAndSlug(webmark);
    webmark.data.tags.forEach((tag) => {
      if (!tagGroups.has(tag)) {
        tagGroups.set(tag, []);
      }
      tagGroups.get(tag)!.push({
        type: 'webmark',
        date,
        url: getWebmarkUrl(webmark),
        title: webmark.data.title,
        description: getWebmarkPreview(webmark),
        tags: webmark.data.tags,
      });
    });
  });

  return Array.from(tagGroups.entries()).map(([tag, items]) => {
    return {
      params: { tag },
      props: { tag, items },
    };
  });
}

const { tag, items } = Astro.props;

// Sort by date and group for display
const sortedItems = items.sort((a, b) => b.date.getTime() - a.date.getTime());

const groupedItems = sortedItems.reduce((groups, item) => {
  const dateStr = item.date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

  if (!groups[dateStr]) {
    groups[dateStr] = [];
  }
  groups[dateStr].push(item);
  return groups;
}, {} as Record<string, TimelineItemData[]>);
---

<BaseLayout title={`Content tagged #${tag}`} description={`All content tagged with ${tag}`}>
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-2 text-[var(--color-terminal-accent)]">
      #{tag}
    </h1>
    <p class="opacity-75">
      {items.length} {items.length === 1 ? 'item' : 'items'}
    </p>
  </div>

  <div class="space-y-8">
    {Object.entries(groupedItems).map(([date, dateItems]) => (
      <TimelineGroup date={date}>
        {dateItems.map((item) => (
          <TimelineItem
            type={item.type}
            title={item.title}
            description={item.description}
            url={item.url}
            tags={item.tags}
          />
        ))}
      </TimelineGroup>
    ))}
  </div>
</BaseLayout>

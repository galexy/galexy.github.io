---
import { getCollection } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import PostLayout from '../../../../layouts/PostLayout.astro';

export const getStaticPaths = (async () => {
  // Fetch all content types
  const [posts, snippets, quotations, til, webmarks] = await Promise.all([
    getCollection('posts', ({ data }) => !data.draft),
    getCollection('snippets', ({ data }) => !data.draft),
    getCollection('quotations', ({ data }) => !data.draft),
    getCollection('til', ({ data }) => !data.draft),
    getCollection('webmarks', ({ data }) => !data.draft),
  ]);

  // Function to generate date-based path
  const generatePaths = (items: any[], type: string) => {
    return items.map(item => {
      const date = item.data.createdAt;
      const year = date.getFullYear();
      const month = String(date.getMonth() + 1).padStart(2, '0');
      const day = String(date.getDate()).padStart(2, '0');

      return {
        params: {
          year: String(year),
          month,
          day,
          slug: item.data.slug,
        },
        props: { item, type },
      };
    });
  };

  // Combine all paths
  return [
    ...generatePaths(posts, 'posts'),
    ...generatePaths(snippets, 'snippets'),
    ...generatePaths(quotations, 'quotations'),
    ...generatePaths(til, 'til'),
    ...generatePaths(webmarks, 'webmarks'),
  ];
}) satisfies GetStaticPaths;

const { item, type } = Astro.props;
const { Content } = await item.render();
---

{type === 'posts' ? (
  <PostLayout {...item.data}>
    <Content />
  </PostLayout>
) : (
  <BaseLayout title={item.data.title || type}>
    <article class={`content-item ${type}`}>
      {type === 'snippets' && (
        <div class="snippet">
          <div class="content-type">Snippet:</div>
          <div class="snippet-content">
            <Content />
          </div>
          <footer class="meta">
            <time datetime={item.data.createdAt.toISOString()}>
              {item.data.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            {item.data.tags.length > 0 && (
              <div class="tags">
                {item.data.tags.map((tag: string) => (
                  <a href={`/tags/${tag}/`}>#{tag}</a>
                ))}
              </div>
            )}
          </footer>
        </div>
      )}

      {type === 'quotations' && (
        <div class="quotation">
          <div class="content-type">Quote:</div>
          <blockquote>
            <p>{item.data.quote}</p>
            <footer>
              — {item.data.author}
              {item.data.source && <cite> in "{item.data.source}"</cite>}
              {item.data.url && (
                <a href={item.data.url} target="_blank" rel="noopener noreferrer">
                  Source
                </a>
              )}
            </footer>
          </blockquote>
          {item.data.highlights && (
            <div class="highlights">
              <strong>Highlights:</strong>
              <p>{item.data.highlights}</p>
            </div>
          )}
          <footer class="meta">
            <time datetime={item.data.createdAt.toISOString()}>
              {item.data.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            {item.data.tags.length > 0 && (
              <div class="tags">
                {item.data.tags.map((tag: string) => (
                  <a href={`/tags/${tag}/`}>#{tag}</a>
                ))}
              </div>
            )}
          </footer>
        </div>
      )}

      {type === 'til' && (
        <div class="til">
          <div class="content-type">TIL:</div>
          <h1>{item.data.title}</h1>
          {item.data.category && <span class="category">{item.data.category}</span>}
          <div class="content">
            <Content />
          </div>
          <footer class="meta">
            <time datetime={item.data.createdAt.toISOString()}>
              {item.data.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            {item.data.tags.length > 0 && (
              <div class="tags">
                {item.data.tags.map((tag: string) => (
                  <a href={`/tags/${tag}/`}>#{tag}</a>
                ))}
              </div>
            )}
          </footer>
        </div>
      )}

      {type === 'webmarks' && (
        <div class="webmark">
          <div class="content-type">Bookmark:</div>
          <h1>
            <a href={item.data.url} target="_blank" rel="noopener noreferrer">
              {item.data.title}
            </a>
          </h1>
          {item.data.description && <p class="original-description">{item.data.description}</p>}
          <div class="notes">
            <strong>Notes:</strong>
            <Content />
          </div>
          <footer class="meta">
            <time datetime={item.data.createdAt.toISOString()}>
              {item.data.createdAt.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
            </time>
            {item.data.tags.length > 0 && (
              <div class="tags">
                {item.data.tags.map((tag: string) => (
                  <a href={`/tags/${tag}/`}>#{tag}</a>
                ))}
              </div>
            )}
          </footer>
        </div>
      )}
    </article>
  </BaseLayout>
)}

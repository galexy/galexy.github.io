---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import TimelineItem from '../../../../components/TimelineItem.astro';
import { getPostDateAndSlug, getPostUrl } from '../../../../lib/posts';
import { getSnippetDateAndSlug, getSnippetUrl, getSnippetPreview } from '../../../../lib/snippets';
import { getQuotationDateAndSlug, getQuotationUrl, getQuotationPreview } from '../../../../lib/quotations';
import { getTilDateAndSlug, getTilUrl, getTilPreview } from '../../../../lib/til';
import { getWebmarkDateAndSlug, getWebmarkUrl, getWebmarkPreview } from '../../../../lib/webmarks';

type TimelineItemData = {
  type: 'post' | 'snippet' | 'quotation' | 'til' | 'webmark';
  date: Date;
  url: string;
  title?: string;
  description?: string;
  tags: string[];
};

interface Props {
  year: string;
  month: string;
  day: string;
  items: TimelineItemData[];
}

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true);
  const snippets = await getCollection('snippets', ({ data }) => data.draft !== true);
  const quotations = await getCollection('quotations', ({ data }) => data.draft !== true);
  const tils = await getCollection('til', ({ data }) => data.draft !== true);
  const webmarks = await getCollection('webmarks', ({ data }) => data.draft !== true);

  // Group items by date
  const dateGroups = new Map<string, TimelineItemData[]>();

  // Add posts
  posts.forEach((post) => {
    const { year, month, day } = getPostDateAndSlug(post);
    const yearStr = String(year);
    const monthStr = String(month).padStart(2, '0');
    const dayStr = String(day).padStart(2, '0');
    const key = `${yearStr}-${monthStr}-${dayStr}`;

    if (!dateGroups.has(key)) {
      dateGroups.set(key, []);
    }
    dateGroups.get(key)!.push({
      type: 'post',
      date: getPostDateAndSlug(post).date,
      url: getPostUrl(post),
      title: post.data.title,
      description: post.data.description,
      tags: post.data.tags,
    });
  });

  // Add snippets
  snippets.forEach((snippet) => {
    const { year, month, day } = getSnippetDateAndSlug(snippet);
    const yearStr = String(year);
    const monthStr = String(month).padStart(2, '0');
    const dayStr = String(day).padStart(2, '0');
    const key = `${yearStr}-${monthStr}-${dayStr}`;

    if (!dateGroups.has(key)) {
      dateGroups.set(key, []);
    }
    dateGroups.get(key)!.push({
      type: 'snippet',
      date: getSnippetDateAndSlug(snippet).date,
      url: getSnippetUrl(snippet),
      description: getSnippetPreview(snippet),
      tags: snippet.data.tags,
    });
  });

  // Add quotations
  quotations.forEach((quotation) => {
    const { year, month, day } = getQuotationDateAndSlug(quotation);
    const yearStr = String(year);
    const monthStr = String(month).padStart(2, '0');
    const dayStr = String(day).padStart(2, '0');
    const key = `${yearStr}-${monthStr}-${dayStr}`;

    if (!dateGroups.has(key)) {
      dateGroups.set(key, []);
    }
    dateGroups.get(key)!.push({
      type: 'quotation',
      date: getQuotationDateAndSlug(quotation).date,
      url: getQuotationUrl(quotation),
      description: `"${getQuotationPreview(quotation)}" — ${quotation.data.author}`,
      tags: quotation.data.tags,
    });
  });

  // Add TILs
  tils.forEach((til) => {
    const { year, month, day } = getTilDateAndSlug(til);
    const yearStr = String(year);
    const monthStr = String(month).padStart(2, '0');
    const dayStr = String(day).padStart(2, '0');
    const key = `${yearStr}-${monthStr}-${dayStr}`;

    if (!dateGroups.has(key)) {
      dateGroups.set(key, []);
    }
    dateGroups.get(key)!.push({
      type: 'til',
      date: getTilDateAndSlug(til).date,
      url: getTilUrl(til),
      description: getTilPreview(til),
      tags: til.data.tags,
    });
  });

  // Add webmarks
  webmarks.forEach((webmark) => {
    const { year, month, day } = getWebmarkDateAndSlug(webmark);
    const yearStr = String(year);
    const monthStr = String(month).padStart(2, '0');
    const dayStr = String(day).padStart(2, '0');
    const key = `${yearStr}-${monthStr}-${dayStr}`;

    if (!dateGroups.has(key)) {
      dateGroups.set(key, []);
    }
    dateGroups.get(key)!.push({
      type: 'webmark',
      date: getWebmarkDateAndSlug(webmark).date,
      url: getWebmarkUrl(webmark),
      title: webmark.data.title,
      description: getWebmarkPreview(webmark),
      tags: webmark.data.tags,
    });
  });

  return Array.from(dateGroups.entries()).map(([key, items]) => {
    const [year, month, day] = key.split('-');
    return {
      params: { year, month, day },
      props: { year, month, day, items },
    };
  });
}

const { year, month, day, items } = Astro.props;

// Parse as local date to avoid timezone issues
const formattedDate = new Date(parseInt(year), parseInt(month) - 1, parseInt(day)).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={`Content from ${formattedDate}`} description={`All content from ${formattedDate}`}>
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-2 text-accent">
      {formattedDate}
    </h1>
    <p class="opacity-75">
      {items.length} {items.length === 1 ? 'item' : 'items'}
    </p>
  </div>

  <div class="space-y-4">
    {items.map((item) => (
      <TimelineItem
        type={item.type}
        title={item.title}
        description={item.description}
        url={item.url}
        tags={item.tags}
      />
    ))}
  </div>
</BaseLayout>

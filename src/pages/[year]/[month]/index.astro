---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TimelineGroup from '../../../components/TimelineGroup.astro';
import TimelineItem from '../../../components/TimelineItem.astro';
import { getPostDateAndSlug, getPostUrl } from '../../../lib/posts';
import { getSnippetDateAndSlug, getSnippetUrl, getSnippetPreview } from '../../../lib/snippets';
import { getQuotationDateAndSlug, getQuotationUrl, getQuotationPreview } from '../../../lib/quotations';

type TimelineItemData = {
  type: 'post' | 'snippet' | 'quotation';
  date: Date;
  url: string;
  title?: string;
  description?: string;
  tags: string[];
};

interface Props {
  year: string;
  month: string;
  items: TimelineItemData[];
}

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.draft !== true);
  const snippets = await getCollection('snippets', ({ data }) => data.draft !== true);
  const quotations = await getCollection('quotations', ({ data }) => data.draft !== true);

  // Group items by year-month
  const monthGroups = new Map<string, TimelineItemData[]>();

  // Add posts
  posts.forEach((post) => {
    const { year, month } = getPostDateAndSlug(post);
    const yearStr = String(year);
    const monthStr = String(month).padStart(2, '0');
    const key = `${yearStr}-${monthStr}`;

    if (!monthGroups.has(key)) {
      monthGroups.set(key, []);
    }
    monthGroups.get(key)!.push({
      type: 'post',
      date: getPostDateAndSlug(post).date,
      url: getPostUrl(post),
      title: post.data.title,
      description: post.data.description,
      tags: post.data.tags,
    });
  });

  // Add snippets
  snippets.forEach((snippet) => {
    const { year, month } = getSnippetDateAndSlug(snippet);
    const yearStr = String(year);
    const monthStr = String(month).padStart(2, '0');
    const key = `${yearStr}-${monthStr}`;

    if (!monthGroups.has(key)) {
      monthGroups.set(key, []);
    }
    monthGroups.get(key)!.push({
      type: 'snippet',
      date: getSnippetDateAndSlug(snippet).date,
      url: getSnippetUrl(snippet),
      description: getSnippetPreview(snippet),
      tags: snippet.data.tags,
    });
  });

  // Add quotations
  quotations.forEach((quotation) => {
    const { year, month } = getQuotationDateAndSlug(quotation);
    const yearStr = String(year);
    const monthStr = String(month).padStart(2, '0');
    const key = `${yearStr}-${monthStr}`;

    if (!monthGroups.has(key)) {
      monthGroups.set(key, []);
    }
    monthGroups.get(key)!.push({
      type: 'quotation',
      date: getQuotationDateAndSlug(quotation).date,
      url: getQuotationUrl(quotation),
      description: `"${getQuotationPreview(quotation)}" — ${quotation.data.author}`,
      tags: quotation.data.tags,
    });
  });

  return Array.from(monthGroups.entries()).map(([key, items]) => {
    const [year, month] = key.split('-');
    return {
      params: { year, month },
      props: { year, month, items },
    };
  });
}

const { year, month, items } = Astro.props;

// Parse as local date to avoid timezone issues
const formattedMonth = new Date(parseInt(year), parseInt(month) - 1, 1).toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
});

// Group items by date for display
const groupedItems = items
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .reduce((groups, item) => {
    const dateStr = item.date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    });

    if (!groups[dateStr]) {
      groups[dateStr] = [];
    }
    groups[dateStr].push(item);
    return groups;
  }, {} as Record<string, TimelineItemData[]>);
---

<BaseLayout title={`Content from ${formattedMonth}`} description={`All content from ${formattedMonth}`}>
  <div class="mb-8">
    <h1 class="text-4xl font-bold mb-2 text-[var(--color-terminal-accent)]">
      {formattedMonth}
    </h1>
    <p class="opacity-75">
      {items.length} {items.length === 1 ? 'item' : 'items'}
    </p>
  </div>

  <div class="space-y-8">
    {Object.entries(groupedItems).map(([date, dateItems]) => (
      <TimelineGroup date={date}>
        {dateItems.map((item) => (
          <TimelineItem
            type={item.type}
            title={item.title}
            description={item.description}
            url={item.url}
            tags={item.tags}
          />
        ))}
      </TimelineGroup>
    ))}
  </div>
</BaseLayout>

---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineGroup from '../components/TimelineGroup.astro';
import TimelineItem from '../components/TimelineItem.astro';
import { getPostDateAndSlug, getPostUrl } from '../lib/posts';

// Get all content
const posts = await getCollection('posts', ({ data }) => data.draft !== true);
const snippets = await getCollection('snippets', ({ data }) => data.draft !== true);

// Create unified timeline items
type TimelineItemData = {
  type: 'post' | 'snippet';
  date: Date;
  url: string;
  title?: string;
  description?: string;
  tags: string[];
  content?: string;
};

const allItems: TimelineItemData[] = [
  ...posts.map((post) => {
    const { date } = getPostDateAndSlug(post);
    return {
      type: 'post' as const,
      date,
      url: getPostUrl(post),
      title: post.data.title,
      description: post.data.description,
      tags: post.data.tags,
    };
  }),
  ...snippets.map((snippet) => {
    // Get raw markdown body and create a simple preview
    const preview = snippet.body.replace(/```[\s\S]*?```/g, '[code]').replace(/[#*`]/g, '').replace(/\s+/g, ' ').trim();
    const truncated = preview.length > 150 ? preview.substring(0, 150) + '...' : preview;

    return {
      type: 'snippet' as const,
      date: new Date(snippet.data.createdAt),
      url: `/snippets/${snippet.slug}`,
      tags: snippet.data.tags,
      description: truncated,
    };
  }),
];

// Sort by date descending
allItems.sort((a, b) => b.date.getTime() - a.date.getTime());

// Group by date
const groupedItems = allItems.reduce((groups, item) => {
  const dateStr = item.date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

  if (!groups[dateStr]) {
    groups[dateStr] = [];
  }
  groups[dateStr].push(item);
  return groups;
}, {} as Record<string, TimelineItemData[]>);
---

<BaseLayout title="My Blog - Home" description="A terminal-inspired blog with posts, snippets, quotations, TIL, and webmarks">
  <div class="space-y-8">
    <section>
      <h1 class="text-4xl font-bold mb-4 text-[var(--color-terminal-accent)]">
        $ whoami
      </h1>
      <p class="text-lg opacity-90 mb-4">
        Welcome to my terminal-inspired blog. A place for thoughts, code, and collections.
      </p>
      <p class="opacity-75">
        This blog features posts, snippets, quotations, things I've learned (TIL), and webmarks—all in one unified timeline.
      </p>
    </section>

    <hr />

    <section>
      <h2 class="text-3xl font-bold mb-6 text-[var(--color-terminal-fg)]">
        Recent Activity
      </h2>

      {Object.entries(groupedItems).map(([date, dateItems]) => (
        <TimelineGroup date={date}>
          {dateItems.map((item) => (
            <TimelineItem
              type={item.type}
              title={item.title}
              description={item.description}
              url={item.url}
              tags={item.tags}
            />
          ))}
        </TimelineGroup>
      ))}

      {allItems.length === 0 && (
        <p class="opacity-75 text-center py-8">
          No content yet. Check back soon!
        </p>
      )}
    </section>
  </div>
</BaseLayout>

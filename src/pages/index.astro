---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TimelineGroup from '../components/TimelineGroup.astro';
import TimelineItem from '../components/TimelineItem.astro';
import { getPostDateAndSlug, getPostUrl } from '../lib/posts';

// Get all posts
const posts = (await getCollection('posts', ({ data }) => {
  return data.draft !== true;
})).sort((a, b) => {
  const aDate = getPostDateAndSlug(a).date;
  const bDate = getPostDateAndSlug(b).date;
  return bDate.getTime() - aDate.getTime();
});

// Group posts by date
const groupedPosts = posts.reduce((groups, post) => {
  const { date } = getPostDateAndSlug(post);
  const dateStr = date.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });

  if (!groups[dateStr]) {
    groups[dateStr] = [];
  }
  groups[dateStr].push(post);
  return groups;
}, {} as Record<string, typeof posts>);
---

<BaseLayout title="My Blog - Home" description="A terminal-inspired blog with posts, snippets, quotations, TIL, and webmarks">
  <div class="space-y-8">
    <section>
      <h1 class="text-4xl font-bold mb-4 text-[var(--color-terminal-accent)]">
        $ whoami
      </h1>
      <p class="text-lg opacity-90 mb-4">
        Welcome to my terminal-inspired blog. A place for thoughts, code, and collections.
      </p>
      <p class="opacity-75">
        This blog features posts, snippets, quotations, things I've learned (TIL), and webmarks—all in one unified timeline.
      </p>
    </section>

    <hr />

    <section>
      <h2 class="text-3xl font-bold mb-6 text-[var(--color-terminal-fg)]">
        Recent Activity
      </h2>

      {Object.entries(groupedPosts).map(([date, datePosts]) => (
        <TimelineGroup date={date}>
          {datePosts.map((post) => (
            <TimelineItem
              type="post"
              title={post.data.title}
              description={post.data.description}
              url={getPostUrl(post)}
              tags={post.data.tags}
            />
          ))}
        </TimelineGroup>
      ))}

      {posts.length === 0 && (
        <p class="opacity-75 text-center py-8">
          No posts yet. Check back soon!
        </p>
      )}
    </section>
  </div>
</BaseLayout>
